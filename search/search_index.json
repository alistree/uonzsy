{"config":{"lang":["en"],"separator":"[\\s\\-]+","pipeline":["stopWordFilter"],"fields":{"title":{"boost":1000.0},"text":{"boost":1.0},"tags":{"boost":1000000.0}}},"docs":[{"location":"","title":"Home","text":""},{"location":"#uon-diploma","title":"\u6fb3\u6d32\u7ebd\u5361\u65af\u5c14\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08UON diploma\uff09\u5b66\u5386\u6587\u51ed\u6837\u5f0f\u53c2\u7167","text":"<p>\u5728\u8de8\u56fd\u6c42\u5b66\u3001\u56de\u56fd\u5c31\u4e1a\u4ee5\u53ca\u843d\u6237\u843d\u6237\u7684\u94fe\u6761\u4e2d\uff0c\u6d77\u5916\u9ad8\u6821\u7684\u5b98\u65b9\u51ed\u8bc1\u8bbe\u8ba1\u4e0e\u9632\u4f2a\u7ec6\u8282\u5f80\u5f80\u662f\u7559\u5b66\u751f\u7fa4\u4f53\u3001\u6d89\u5916\u4f01\u4e1aHR\u53ca\u7b2c\u4e09\u65b9\u5b66\u5386\u8ba4\u8bc1\u673a\u6784\u5171\u540c\u5173\u6ce8\u7684\u7126\u70b9\u3002\u4f5c\u4e3a\u957f\u5e74\u4f4d\u5c45\u5168\u7403\u524d200\u5f3a\u7684\u9876\u5c16\u5b66\u5e9c\uff0c\u6fb3\u5927\u5229\u4e9a\u7ebd\u5361\u65af\u5c14\u5927\u5b66\uff08The University of Newcastle, \u7b80\u79f0 UON\uff09\u7684\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u4e0d\u4ec5\u4ee3\u8868\u4e86\u6301\u8bc1\u4eba\u7684\u5b66\u672f\u6210\u5c31\uff0c\u5176\u72ec\u7279\u7684\u7248\u9762\u7f8e\u5b66\u548c\u6570\u5b57\u9632\u4f2a\u4f53\u7cfb\u5728\u56fd\u9645\u4e0a\u4e5f\u4eab\u6709\u6781\u9ad8\u7684\u8fa8\u8bc6\u5ea6\u3002</p> <p></p> <p>\u672c\u6587\u5c06\u7ed3\u5408UON\u5b98\u65b9\u53d1\u5e03\u7684\u6807\u51c6\u89c4\u8303\u4e0e\u6700\u65b0\u6837\u672c\uff0c\u5bf9\u6fb3\u6d32\u7ebd\u5361\u65af\u5c14\u5927\u5b66\u6bd5\u4e1a\u8bc1\uff08UON diploma\uff09\u7684\u5b66\u5386\u6587\u51ed\u6837\u5f0f\u8fdb\u884c\u6df1\u5ea6\u62c6\u89e3\uff0c\u5e2e\u52a9\u5927\u5bb6\u591a\u7ef4\u5ea6\u4e86\u89e3\u5176\u89c6\u89c9\u7279\u5f81\u4e0e\u73b0\u4ee3\u9632\u4f2a\u673a\u5236\u3002</p>"},{"location":"#uonvisual-elements","title":"\u4e00\u3001 UON\u6bd5\u4e1a\u8bc1\u6838\u5fc3\u89c6\u89c9\u5143\u7d20\u4e0e\u6392\u7248\u89e3\u6790\uff08Visual Elements\uff09","text":"<p>\u6839\u636e\u6fb3\u5927\u5229\u4e9a\u7ebd\u5361\u65af\u5c14\u5927\u5b66\u5b98\u65b9\u6bd5\u4e1a\u5178\u793c\u89c4\u8303\uff0c\u6807\u51c6\u7684UON\u7eb8\u8d28\u5b66\u4f4d\u8bc1\u4e66\u4e3b\u8981\u7531\u4ee5\u4e0b\u51e0\u4e2a\u6838\u5fc3\u677f\u5757\u6784\u6210\uff0c\u6574\u4f53\u98ce\u683c\u5e84\u91cd\u3001\u4e25\u8c28\uff1a</p>"},{"location":"#1","title":"1. \u9876\u90e8\uff1a\u5927\u5b66\u5b98\u65b9\u6821\u5fbd\u4e0e\u6807\u51c6\u5b57\u6837","text":"<p>\u8bc1\u4e66\u6b63\u4e0a\u65b9\u6b63\u4e2d\u4f4d\u7f6e\uff0c\u5370\u6709UON\u6807\u5fd7\u6027\u7684\u9ed1\u9a6c\u56fe\u817e\u6821\u5fbd\u3002\u6821\u5fbd\u4e0b\u65b9\u4e3a\u7cbe\u5fc3\u8bbe\u8ba1\u7684\u5927\u53f7\u886c\u7ebf\u5b57\u4f53\uff1a</p> <p>The UNIVERSITY of NEWCASTLE</p>"},{"location":"#2","title":"2. \u6388\u6743\u58f0\u660e\u8bed\u4e0e\u5b66\u751f\u59d3\u540d","text":"<p>\u6821\u5fbd\u4e0b\u65b9\u662f\u6838\u5fc3\u7684\u6cd5\u5f8b\u6388\u6743\u6587\u672c\uff1a\u201cBy the Authority of the Council\u201d\uff08\u7ecf\u5927\u5b66\u7406\u4e8b\u4f1a\u6388\u6743\uff09\u3002\u5176\u4e0b\u7d27\u63a5\u7740\u6301\u8bc1\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u82f1\u6587\u59d3\u540d\u3002\u6839\u636eUON\u5b98\u65b9\u59d3\u540d\u5370\u5237\u653f\u7b56\uff0c\u6b64\u5904\u7684\u59d3\u540d\u5fc5\u987b\u4e0e\u5b66\u751f\u5728\u5b66\u6821\u6ce8\u518c\u7684\u5408\u6cd5\u8eab\u4efd\u8bc1\u660e\uff08\u5982\u62a4\u7167\uff09\u4fdd\u6301\u5b8c\u5168\u4e00\u81f4\u3002</p>"},{"location":"#3","title":"3. \u6388\u4e88\u5b66\u4f4d\u4e0e\u4fee\u8bfb\u4e13\u4e1a","text":"<p>\u5728\u201chaving satisfied the requirements was admitted to the degree of\u201d\uff08\u6ee1\u8db3\u6240\u6709\u8981\u6c42\u540e\u88ab\u6388\u4e88\u5b66\u4f4d\uff09\u540e\uff0c\u4f1a\u7528\u8f83\u5927\u5b57\u53f7\u7684\u9ed1\u4f53\u5199\u660e\u5177\u4f53\u7684\u5b66\u4f4d\u540d\u79f0\u4e0e\u4e13\u4e1a\u65b9\u5411\u3002 *   \u6837\u5f0f\u53c2\u8003\uff1a \u5e38\u89c1\u5982\u201cGraduate Certificate in Clinical Epidemiology\u201d\uff08\u4e34\u5e8a\u6d41\u884c\u75c5\u5b66\u7814\u7a76\u751f\u8bc1\u4e66\uff09\u3002 *   \u4e13\u4e1a\u80cc\u666f\uff1a UON\u7684\u533b\u5b66\u3001\u516c\u5171\u536b\u751f\u53ca\u6d41\u884c\u75c5\u5b66\u5728\u56fd\u9645\u4e0a\u4eab\u6709\u76db\u8a89\uff0c\u5176\u4e34\u5e8a\u6d41\u884c\u75c5\u5b66\u76f8\u5173\u7814\u7a76\u751f\u8bfe\u7a0b\u5728\u4e1a\u5185\u8ba4\u53ef\u5ea6\u6781\u9ad8\u3002</p>"},{"location":"#4","title":"4. \u6388\u4e88\u65e5\u671f","text":"<p>\u5728\u5b66\u4f4d\u4e0b\u65b9\u4f1a\u6807\u660e\u5177\u4f53\u7684\u6bd5\u4e1a\u6388\u4e88\u65f6\u95f4\u3002\u4f8b\u5982\uff0c\u6700\u65b0\u7684\u6bd5\u4e1a\u751f\u8bc1\u4e66\u4e0a\u4f1a\u7cbe\u786e\u5199\u660e\u201con the [\u65e5\u671f] day of [\u6708\u4efd] [\u5e74\u4efd]\u201d\u3002</p>"},{"location":"#style-anti-counterfeiting","title":"\u4e8c\u3001 \u5e95\u90e8\u7b7e\u7ae0\u4e0e\u5b89\u5168\u9632\u4f2a\u5370\u8bb0\uff08Style \uff06 Anti-counterfeiting\uff09","text":"<p>\u8bc1\u4e66\u7684\u5e95\u90e8\u662f\u4f53\u73b0\u5176\u6cd5\u5f8b\u6548\u529b\u4e0e\u5b98\u65b9\u9632\u4f2a\u7684\u5bc6\u96c6\u533a\u57df\uff0c\u4e3b\u8981\u5305\u62ec\u4ee5\u4e0b\u4e09\u4e2a\u90e8\u5206\uff1a</p>"},{"location":"#1_1","title":"1. \u5de6\u4e0b\u89d2\uff1a\u5927\u5b66\u5b98\u65b9\u70eb\u91d1\u94a2\u5370","text":"<p>\u8bc1\u4e66\u5de6\u4e0b\u89d2\u6709\u4e00\u4e2a\u5706\u5f62\u7684\u6fb3\u5927\u5229\u4e9a\u7ebd\u5361\u65af\u5c14\u5927\u5b66\u5b98\u65b9\u5370\u7ae0\uff08THE UNIVERSITY OF NEWCASTLE AUSTRALIA\uff09\u3002\u5728\u7eb8\u8d28\u539f\u4ef6\u4e0a\uff0c\u8be5\u5370\u7ae0\u901a\u5e38\u5e26\u6709\u7acb\u4f53\u51f9\u51f8\u611f\u548c\u5fae\u7f29\u9632\u4f2a\u5e95\u7eb9\uff0c\u662f\u89c6\u89c9\u4e0a\u6700\u96be\u88ab\u7b80\u6613\u590d\u5236\u7684\u6838\u5fc3\u5de5\u827a\u4e4b\u4e00\u3002</p>"},{"location":"#2_1","title":"2. \u6b63\u4e0b\u65b9\uff1a\u5927\u5b66\u9ad8\u5c42\u624b\u5199\u7b7e\u7ae0","text":"<p>\u8bc1\u4e66\u6b63\u4e0b\u65b9\u5370\u6709\u4e24\u4f4d\u5927\u5b66\u6838\u5fc3\u7ba1\u7406\u8005\u7684\u6cd5\u5b9a\u7b7e\u540d\uff1a *   CHANCELLOR\uff08\u5927\u5b66\u6821\u76d1\uff09 *   VICE-CHANCELLOR AND UNIVERSITY PRESIDENT\uff08\u526f\u6821\u957f\u517c\u6821\u957f\uff09</p>"},{"location":"#3_1","title":"3. \u53f3\u4e0b\u89d2\uff1a\u5b66\u751f\u552f\u4e00\u7f16\u53f7\u4e0e\u73b0\u4ee3\u6570\u7801\u6807\u8bc6","text":"<p>\u53f3\u4e0b\u89d2\u4f1a\u6e05\u6670\u5730\u6253\u5370\u51fa\u5b66\u751f\u4e2a\u4eba\u552f\u4e00ID\u7f16\u53f7\uff08Student ID\uff09\u3002\u6b64\u5916\uff0c\u5728\u8fd1\u5e74\u9881\u53d1\u7684\u8bc1\u4e66\u4e2d\uff0c\u53f3\u4e0b\u89d2\u8fd8\u914d\u6709\u4e00\u4e2a\u5e26\u6709UON\u9a6c\u6807\u53ca\u5927\u5b66\u5168\u79f0\u7684\u7070\u8272\u77e9\u5f62\u6570\u5b57\u6807\u8bc6\u5757\u3002\u8fd9\u4e00\u6807\u8bc6\u5757\u4e0e\u5927\u5b66\u7684\u6570\u5b57\u8bc1\u4e66\u6570\u636e\u5e93\u76f4\u63a5\u6302\u94a9\u3002</p>"},{"location":"#uon","title":"\u4e09\u3001 \u5982\u4f55\u9a8c\u8bc1UON\u6587\u51ed\u771f\u4f2a\uff1f","text":"<p>\u5728\u8c37\u6b4c\u548c\u767e\u5ea6\u7684\u641c\u7d22\u9ad8\u9891\u8bcd\u4e2d\uff0c\u201c\u7559\u670d\u8ba4\u8bc1\u201d\u3001\u201c\u6d77\u5916\u6bd5\u4e1a\u8bc1\u771f\u4f2a\u67e5\u8be2\u201d\u3001\u201cMy eQuals \u600e\u4e48\u7528\u201d\u7b49\u8bcd\u6761\u957f\u671f\u70ed\u5ea6\u4e0d\u51cf\u3002\u8fd9\u4e5f\u53cd\u6620\u51fa\u5927\u5bb6\u5bf9\u6587\u51ed\u771f\u5b9e\u6027\u548c\u53ef\u6838\u9a8c\u6027\u7684\u91cd\u89c6\u3002</p> <p>\u81ea2018\u5e74\u8d77\uff0c\u6fb3\u6d32\u7ebd\u5361\u65af\u5c14\u5927\u5b66\u4fbf\u5168\u9762\u5f15\u5165\u4e86\u73b0\u4ee3\u5316\u3001\u6570\u5b57\u5316\u7684\u6587\u51ed\u7ba1\u7406\u673a\u5236\u3002\u4e3a\u4e86\u4fdd\u62a4\u6bd5\u4e1a\u751f\u7684\u5408\u6cd5\u6743\u76ca\uff0c\u5b66\u6821\u4e0d\u9f13\u52b1\u4e14\u660e\u786e\u8bf4\u660e\u7eb8\u8d28\u590d\u5370\u4ef6\u6216\u666e\u901a\u6253\u5370\u4ef6\u4e0d\u5177\u5907\u5b98\u65b9\u72ec\u7acb\u9a8c\u8bc1\u529f\u80fd\u3002\u5b98\u65b9\u63a8\u8350\u4e14\u8ba4\u53ef\u7684\u9a8c\u8bc1\u6e20\u9053\u5982\u4e0b\uff1a</p>"},{"location":"#1-my-equals","title":"1. \u56fd\u9645\u4e3b\u6d41\uff1aMy eQuals \u6570\u5b57\u51ed\u8bc1\u5e73\u53f0","text":"<p>UON \u5b98\u65b9\u6bd5\u4e1a\u4fe1\u606f\u6307\u5357\u6307\u51fa\uff0c2018\u5e74\u53ca\u4e4b\u540e\u6bd5\u4e1a\u7684\u6240\u6709\u5b66\u751f\uff0c\u5b66\u6821\u90fd\u4f1a\u901a\u8fc7 My eQuals \u5e73\u53f0\u53d1\u5e03\u5b98\u65b9\u6570\u5b57\u5b66\u4f4d\u8bc1\u4e66\uff08Testamur\uff09\u3001\u5b66\u672f\u6210\u7ee9\u5355\uff08Academic Transcript\uff09\u4ee5\u53ca\u6fb3\u5927\u5229\u4e9a\u9ad8\u7b49\u6559\u80b2\u6bd5\u4e1a\u751f\u8bf4\u660e\u4e66\uff08AHEGS\uff09\u3002 *   \u5b89\u5168\u673a\u5236\uff1a \u8be5\u5e73\u53f0\u751f\u6210\u7684\u7535\u5b50\u6587\u6863\u5305\u542b\u72ec\u7279\u7684\u6570\u5b57\u52a0\u5bc6\u7b7e\u540d\u4e0e\u9632\u7be1\u6539\u7279\u5f81\u3002 *   \u5171\u4eab\u65b9\u5f0f\uff1a \u6bd5\u4e1a\u751f\u53ef\u4e00\u952e\u751f\u6210\u5b89\u5168\u7684\u5728\u7ebf\u5171\u4eab\u94fe\u63a5\uff0c\u7b2c\u4e09\u65b9\u96c7\u4e3b\u6216\u8ba4\u8bc1\u673a\u6784\u53ef\u4ee5\u901a\u8fc7\u8be5\u94fe\u63a524\u5c0f\u65f6\u968f\u65f6\u5728\u7ebf\u79d2\u7ea7\u6838\u9a8c\u3002</p>"},{"location":"#2-graduate-register","title":"2. \u5b98\u65b9\u516c\u5f00\u6e20\u9053\uff1a\u6bd5\u4e1a\u751f\u540d\u518c\uff08Graduate Register\uff09","text":"<p>\u5bf9\u4e8e\u7b2c\u4e09\u65b9\u4f01\u4e1aHR\u800c\u8a00\uff0c\u53ef\u4ee5\u76f4\u63a5\u901a\u8fc7UON \u5b98\u65b9\u6bd5\u4e1a\u751f\u540d\u518c\uff08Graduate Register\uff09\u8fdb\u884c\u81ea\u52a9\u67e5\u8be2\u3002\u53ea\u9700\u8f93\u5165\u6bd5\u4e1a\u751f\u7684\u6cd5\u5b9a\u59d3\u540d\uff0c\u7cfb\u7edf\u4fbf\u80fd\u76f4\u63a5\u68c0\u7d22\u5e76\u6838\u5b9e\u5176\u6240\u83b7\u5b66\u4f4d\u7684\u771f\u5b9e\u6027\uff0c\u8fd9\u4e5f\u662f\u9632\u8303\u5b66\u5386\u9020\u5047\u7684\u5229\u5668\u3002</p>"},{"location":"#3-cscse","title":"3. \u56fd\u5185\u6743\u5a01\uff1a\u4e2d\u56fd\u6559\u80b2\u90e8\u7559\u5b66\u670d\u52a1\u4e2d\u5fc3\uff08CSCSE\uff09\u8ba4\u8bc1","text":"<p>\u5bf9\u4e8e\u8ba1\u5212\u56de\u56fd\u53d1\u5c55\u7684\u7559\u5b66\u751f\u800c\u8a00\uff0cUON\u9881\u53d1\u7684\u6807\u51c6\u6b63\u89c4\u7eb8\u8d28\u6587\u51ed\u6216 My eQuals \u6570\u5b57\u51ed\u8bc1\u5747\u7b26\u5408\u4e2d\u56fd\u6559\u80b2\u90e8\u7684\u8ba4\u8bc1\u6807\u51c6\u3002\u6bd5\u4e1a\u751f\u53ef\u4ee5\u901a\u8fc7\u7559\u670d\u4e2d\u5fc3\u5b98\u7f51\u63d0\u4ea4\u7533\u8bf7\uff0c\u53ea\u8981\u6750\u6599\u771f\u5b9e\u5b8c\u6574\uff0c\u901a\u5e38\u80fd\u987a\u5229\u901a\u8fc7\u6d77\u5916\u5b66\u5386\u5b66\u4f4d\u8ba4\u8bc1\u3002</p>"},{"location":"#_1","title":"\u56db\u3001 \u603b\u7ed3\u4e0e\u7ed3\u8bed","text":"<p>\u6fb3\u6d32\u7ebd\u5361\u65af\u5c14\u5927\u5b66\u7684\u6bd5\u4e1a\u8bc1\u6837\u5f0f\u5728\u4fdd\u6301\u4f20\u7edf\u82f1\u8054\u90a6\u5927\u5b66\u5b66\u672f\u7f8e\u611f\u7684\u540c\u65f6\uff0c\u7d27\u8ddf\u6570\u5b57\u65f6\u4ee3\u6b65\u4f10\u3002\u5176\u6e05\u6670\u7684\u6392\u7248\u3001\u7cbe\u81f4\u7684\u7269\u7406\u94a2\u5370\u4ee5\u53ca\u5148\u8fdb\u7684 My eQuals \u6570\u5b57\u5316\u53cc\u91cd\u6838\u9a8c\u4f53\u7cfb\uff0c\u5171\u540c\u6784\u5efa\u4e86\u4e25\u5bc6\u7684\u771f\u5b9e\u6027\u4fdd\u62a4\u7f51\u3002 </p> <p>\u5efa\u8bae\u5e7f\u5927\u6821\u53cb\u53ca\u51c6\u6bd5\u4e1a\u751f\uff0c\u5728\u59a5\u5584\u4fdd\u7ba1\u597d\u4e2a\u4eba\u7eb8\u8d28\u5b66\u4f4d\u8bc1\u539f\u4ef6\u7684\u540c\u65f6\uff0c\u5145\u5206\u6fc0\u6d3b\u5e76\u5229\u7528\u597d\u5b66\u6821\u63d0\u4f9b\u7684\u5b98\u65b9\u6570\u5b57\u51ed\u8bc1\u8d26\u6237\uff0c\u4ee5\u4fbf\u5728\u672a\u6765\u7684\u6c42\u804c\u3001\u5347\u5b66\u6216\u56de\u56fd\u5b66\u5386\u8ba4\u8bc1\u4e2d\uff0c\u66f4\u9ad8\u6548\u3001\u5b89\u5168\u5730\u5c55\u793a\u81ea\u5df1\u7684\u5b66\u672f\u6210\u679c\u3002 \u6670\u3001\u53ef\u9760\u7684\u89c6\u89c9\u4e0e\u903b\u8f91\u4f9d\u636e\u3002</p>"}]}